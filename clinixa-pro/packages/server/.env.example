# ==============================
# Clinixa Server — Environment Variables
# انسخ الملف ده إلى .env وحط القيم الحقيقية بتاعتك
# ==============================

# ---- عام ----
NODE_ENV=development
PORT=4321

# ---- قاعدة البيانات المحلية (SQLite) ----
# المسار بيتحدد وقت التشغيل جوه Electron (userData folder) — القيمة دي للتطوير بس
SQLITE_DB_PATH=./data/clinixa.db

# ---- المصادقة (Auth) ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# ---- رفع الملفات (مستندات المريض) ----
UPLOADS_DIR=./data/attachments
MAX_UPLOAD_SIZE_MB=20

# ---- النسخ الاحتياطي ----
BACKUP_LOCAL_DIR=./data/backups

# ---- المزامنة بين الفروع (MongoDB Atlas) ----
# لا تضع URI حقيقي داخل التطبيق أو Installer. استخدم Secret/Environment في خادم المزامنة فقط.
# سيبها فاضية لو sync_mode = none (فرع واحد بس)
MONGODB_URI=
# Public DNS fallback for Atlas SRV resolution (comma-separated)
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
SYNC_ENABLED=false
SYNC_POLL_INTERVAL_MS=30000
SYNC_MAX_ATTEMPTS=5

# ---- CORS (مصدر الفرونت وقت التطوير) ----
CORS_ORIGIN=http://localhost:5173

# ---- الترخيص ----
LICENSE_VALIDATION_MODE=offline
