{
  "name": "clinixa",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "Clinixa Clinic Management System",
  "main": "packages/electron/dist/main.js",
  "scripts": {
    "dev": "npm run dev --workspace=electron",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "dist": "electron-builder --win nsis",
    "test": "npm run test --workspace=server"
  },
  "build": {
    "electronVersion": "37.10.3",
    "appId": "com.clinixa.app",
    "productName": "Clinixa Pro",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "packages/electron/dist/**/*",
      "packages/client/dist/**/*",
      "packages/server/dist/**/*",
      "packages/server/package.json",
      "packages/shared/dist/**/*",
      "packages/shared/package.json",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "C:/temp/clinixa-icon/clinixa.ico",
      "sign": null,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clinixa Pro"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^25.1.8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}